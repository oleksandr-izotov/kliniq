# Reverse proxy for both local prod-image testing and the real Hetzner
# deploy. The site address is parameterised on PRIMARY_DOMAIN:
#
#   - Local: PRIMARY_DOMAIN=:80 ⇒ Caddy listens on plain HTTP, no cert.
#   - Prod:  PRIMARY_DOMAIN=kliniq.izotov.dev ⇒ Caddy auto-provisions
#            a Let's Encrypt cert and forces HTTPS, all without any
#            additional config.
#
# Path routing is identical in both environments so nothing else has
# to change between local prod-image testing and the real deploy.

{$PRIMARY_DOMAIN} {
	# API endpoints — backend handles them all under /api/v1, plus
	# springdoc paths, plus Spring Actuator for healthchecks.
	@api {
		path /api/* /v3/api-docs* /swagger-ui* /actuator/*
	}
	reverse_proxy @api api:8080

	# Everything else — SPA + SvelteKit-rendered routes.
	reverse_proxy web:3000

	# Compress responses where it helps.
	encode gzip zstd
}
