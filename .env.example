# Local development environment template.
# Copy this file to `.env` and adjust values as needed.
# Never commit `.env` (it's in .gitignore).

# --- App URLs ---
APP_BASE_URL=https://localhost:5173
API_BASE_URL=https://localhost:8443

# --- PostgreSQL (matches compose.yaml service "postgres") ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kliniq
POSTGRES_USER=kliniq
POSTGRES_PASSWORD=kliniq_dev_only

# --- Redis (matches compose.yaml service "redis") ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Mailpit (local SMTP catcher; UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@kliniq.local

# --- Session ---
# 32+ random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-random-32-byte-base64-string

# --- WebAuthn (passkeys) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kliniq
WEBAUTHN_RP_ORIGIN=https://localhost:5173
