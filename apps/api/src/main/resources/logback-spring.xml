<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot picks up logback-spring.xml from classpath ahead of the
  default config. The <springProfile> blocks let dev keep Spring Boot's
  pretty colored console while prod ships JSON-per-line to stdout — same
  shape any modern log aggregator (Loki, Logfmt, ElasticSearch, Coolify's
  built-in viewer) ingests without extra parsing.

  Standard fields per ARCHITECTURE.md "Logging" section:
    @timestamp, level, logger_name, message, thread_name,
    plus MDC entries (traceId / requestId / userId once those filters
    populate them — none of which carry PII).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Dev profile (default): colored console, fits humans. -->
    <springProfile name="local | test | default">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Prod profile: JSON-per-line on stdout via logstash-logback-encoder. -->
    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Constant fields baked into every line for filtering. -->
                <customFields>{"app":"kliniq-api","env":"prod"}</customFields>
                <!-- MDC keys we'd actually use; missing ones are dropped silently. -->
                <includeMdc>true</includeMdc>
                <!-- Stack traces inline-encoded with one shortened element per line. -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>2048</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
        <!-- Spring's HTTP access logging is at DEBUG; we want INFO for
             unknown deployments. Audit + booking logs are domain-level
             and stay at INFO via slf4j's normal path. -->
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.flywaydb" level="INFO"/>
    </springProfile>
</configuration>
